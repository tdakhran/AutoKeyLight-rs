{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoKeyLight",
  "identifier": "com.tdakhran.autokeylight",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AutoKeyLight",
        "width": 360,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "Tarek Dakhran",
    "copyright": "© 2026 Tarek Dakhran",
    "homepage": "https://github.com/tdakhran/AutoKeyLight-rs",
    "category": "Utility",
    "shortDescription": "Turns your Elgato lights on and off with your webcam",
    "longDescription": "Turns your Elgato lights on and off when your webcam turns on and off. A rewrite of AutoKeyLight by Gabriel Garcia.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
