{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoKeyLight",
  "version": "0.1.0",
  "identifier": "com.tdakhran.autokeylight",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AutoKeyLight",
        "width": 360,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
